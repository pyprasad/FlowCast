NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatorflow_auth?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email Provider (mock for development)
EMAIL_PROVIDER_API_KEY=mock
EMAIL_FROM=noreply@creatorflow.app

# Bcrypt
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

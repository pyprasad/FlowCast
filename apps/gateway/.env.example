NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Redis
REDIS_URL=redis://localhost:6379

# Service URLs
AUTH_SERVICE_URL=http://localhost:4001
BILLING_SERVICE_URL=http://localhost:4002
API_KEYS_SERVICE_URL=http://localhost:4003
PLATFORM_SERVICE_URL=http://localhost:4004
VIDEO_SERVICE_URL=http://localhost:4005
SCHEDULER_SERVICE_URL=http://localhost:4006
ANALYTICS_SERVICE_URL=http://localhost:4007
COMMENTS_SERVICE_URL=http://localhost:4008
AI_SERVICE_URL=http://localhost:4009

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Secret (for validation)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database (for gateway metrics if needed)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatorflow_gateway?schema=public
